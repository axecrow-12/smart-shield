# --- Node backend ---
PORT=5050

# URL of the Python ML fraud-scoring service
ML_API_URL=http://127.0.0.1:8000
# How long to wait for the ML service before falling back to local rules (ms)
ML_TIMEOUT_MS=2500

# --- Firebase ---
FIREBASE_PROJECT_ID=smartpay-shield

# DEMO MODE (recommended, no cloud credentials needed):
# run `firebase emulators:start --only firestore` in another terminal, then:
FIRESTORE_EMULATOR_HOST=localhost:8765
# Uncomment if you also run the Auth emulator:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# CLOUD MODE: comment out the emulator lines above and either place
# serviceAccountKey.json at the repo root, or set:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json
